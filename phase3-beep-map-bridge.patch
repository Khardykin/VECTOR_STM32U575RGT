diff --git a/Core/Inc/extstore.h b/Core/Inc/extstore.h
new file mode 100644
index 0000000..5e98fe1
--- /dev/null
+++ b/Core/Inc/extstore.h
@@ -0,0 +1,66 @@
+/**
+  ******************************************************************************
+  * @file    extstore.h
+  * @brief   Потокобезопасный доступ к внешней SPI flash + конфигурация + журнал
+  *
+  *          ЕДИНАЯ ТОЧКА ВХОДА во внешнюю flash. Все обращения из любых потоков
+  *          идут через этот модуль и сериализуются мьютексом: SPI-шина и
+  *          состояние чипа (WREN/WIP) не допускают параллельных операций.
+  *
+  *          Правило: НЕ вызывать sf_read/sf_program/sf_sector_erase напрямую
+  *          из прикладного кода. Исключение - ранняя инициализация до старта
+  *          планировщика (см. audio_init), когда потоков ещё нет.
+  *
+  *          Адреса брать из sfmap.h (SF_SOUNDS_BASE / SF_CONFIG_* / SF_LOG_BASE).
+  ******************************************************************************
+  */
+#ifndef EXTSTORE_H
+#define EXTSTORE_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Вызывать один раз из tx_application_define(), ДО audio_init() и потоков.
+   Создаёт мьютекс и сканирует журнал (находит текущий сектор записи). */
+void ext_init(void);
+
+/* --- сырой доступ (адреса - абсолютные по чипу, из sfmap.h) --------------- */
+int ext_read(uint32_t addr, uint8_t *dst, uint32_t len);            /* 0 = ok */
+int ext_write(uint32_t addr, const uint8_t *src, uint32_t len);     /* 0 = ok,
+     область должна быть стёрта */
+int ext_erase_sector(uint32_t addr);                                /* 0 = ok */
+
+/* --- конфигурация устройства ---------------------------------------------
+ * Хранится в ДВУХ резервных слотах: пишется всегда в тот, у которого seq
+ * меньше (второй остаётся нетронутым => сбой питания не убивает конфиг).
+ * Запись слота: [u32 seq][u16 len][u16 pad][u32 crc32][данные]
+ */
+int cfg_save(const void *data, uint16_t len);                 /* 0 = ok      */
+int cfg_load(void *data, uint16_t max_len, uint16_t *out_len);/* 0 = ok,
+     -1 = конфига ещё нет */
+
+/* --- кольцевой журнал ------------------------------------------------------
+ * Append-only поверх секторов области LOG. Когда в текущем секторе нет
+ * места - следующий сектор стирается и становится текущим (seq + 1).
+ * Запись: [u16 len][u16 pad][u32 crc32][данные]
+ */
+int log_append(const void *data, uint16_t len);               /* 0 = ok      */
+
+/* Чтение записей журнала по одной, от самой старой доступной к новой.
+ * Возвращает 0 = запись отдана, 1 = записей больше нет, <0 = ошибка.
+ * *handle = 0 при первом вызове; модуль сам ведёт курсор внутри handle. */
+int log_next(uint32_t *handle, void *data, uint16_t max_len, uint16_t *out_len);
+
+/* --- отладка -------------------------------------------------------------- */
+extern volatile uint32_t ext_dbg_log_sector;   /* текущий сектор журнала      */
+extern volatile uint32_t ext_dbg_log_offset;   /* смещение записи в секторе   */
+extern volatile uint32_t ext_dbg_cfg_seq;      /* seq последнего конфига      */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* EXTSTORE_H */
diff --git a/Core/Inc/sfmap.h b/Core/Inc/sfmap.h
new file mode 100644
index 0000000..8db9840
--- /dev/null
+++ b/Core/Inc/sfmap.h
@@ -0,0 +1,59 @@
+/**
+  ******************************************************************************
+  * @file    sfmap.h
+  * @brief   Карта разделов внешней SPI flash MX25K6435F (8 МБ)
+  *
+  *          Весь чип делится на три непересекающиеся области. Адреса всех
+  *          операций с флеш обязаны проходить через эти константы - тогда
+  *          звуки, конфигурация и логи никогда не перетирают друг друга.
+  *
+  *          0x000000 +----------------------------+
+  *                   | SOUNDS  4 МБ               |  sounds.img (целиком)
+  *          0x400000 +----------------------------+
+  *                   | CONFIG  128 КБ             |  кольцо из 32 секторов 4 КБ
+  *          0x420000 +----------------------------+
+  *                   | LOG     3.875 МБ           |  кольцевой журнал секторами
+  *          0x800000 +----------------------------+
+  *
+  *          Стирание у NOR flash идёт секторами по 4 КБ, поэтому все границы
+  *          выровнены на 4096.
+  ******************************************************************************
+  */
+#ifndef SFMAP_H
+#define SFMAP_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SF_CHIP_SIZE        0x00800000u     /* 8 МБ                            */
+
+/* --- SOUNDS: образ sounds.img ------------------------------------------- */
+#define SF_SOUNDS_BASE      0x00000000u
+#define SF_SOUNDS_SIZE      0x00400000u     /* 4 МБ = ~262 с PCM 8 кГц         */
+
+/* --- CONFIG: конфигурация устройства ------------------------------------
+ * Кольцо из 32 секторов по 4 КБ, в секторе одна запись с seq и CRC.
+ * Пишем в следующий сектор по кругу => свежая и предыдущая копии живы
+ * одновременно (защита от сбоя питания), плюс выравнивание износа.        */
+#define SF_CONFIG_BASE      0x00400000u
+#define SF_CONFIG_SIZE      0x00020000u     /* 128 КБ = 32 сектора по 4 КБ     */
+
+/* --- LOG: кольцевой журнал ------------------------------------------------ */
+#define SF_LOG_BASE         0x00420000u
+#define SF_LOG_SIZE         (SF_CHIP_SIZE - SF_LOG_BASE)   /* 3.875 МБ        */
+#define SF_LOG_SECTORS      (SF_LOG_SIZE / 4096u)
+
+/* Проверка карты на этапе компиляции */
+typedef char sfmap_assert_bounds
+    [(SF_SOUNDS_BASE + SF_SOUNDS_SIZE == SF_CONFIG_BASE) ? 1 : -1];
+typedef char sfmap_assert_end
+    [(SF_LOG_BASE + SF_LOG_SIZE == SF_CHIP_SIZE) ? 1 : -1];
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SFMAP_H */
